{%- comment -%}
  Inline SVG icon set. Usage: {% render 'mc-icon', name: 'bag' %}
  Optional: size (px, default 20)
{%- endcomment -%}
{%- assign mc_icon_size = size | default: 20 -%}
<svg class="mc-icon mc-icon--{{ name }}" width="{{ mc_icon_size }}" height="{{ mc_icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'search' -%}<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>
    {%- when 'heart' -%}<path d="M20.8 8.6c0 5.6-8.8 10.4-8.8 10.4S3.2 14.2 3.2 8.6A4.6 4.6 0 0 1 12 6.1a4.6 4.6 0 0 1 8.8 2.5Z"/>
    {%- when 'user' -%}<circle cx="12" cy="8" r="3.4"/><path d="M5.5 20c.8-3.5 3.1-5.2 6.5-5.2s5.7 1.7 6.5 5.2"/>
    {%- when 'bag' -%}<path d="M5 8h14l-1.1 12H6.1L5 8Z"/><path d="M9 8V7a3 3 0 0 1 6 0v1"/>
    {%- when 'truck' -%}<path d="M3 6.5h11v9H3z"/><path d="M14 9.5h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/>
    {%- when 'shield' -%}<path d="M12 3 5 5.8v5.5c0 4.4 2.9 7.6 7 9.2 4.1-1.6 7-4.8 7-9.2V5.8L12 3Z"/><path d="m9 12 2.2 2.2L15.2 10"/>
    {%- when 'return' -%}<path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="m8 5-4 4 4 4"/>
    {%- when 'sparkle' -%}<path d="M12 3.5 13.9 9l5.6 1.9-5.6 1.9L12 18.5l-1.9-5.7-5.6-1.9L10.1 9 12 3.5Z"/><path d="M19 3v3M17.5 4.5h3"/>
    {%- when 'arrow' -%}<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
    {%- when 'home' -%}<path d="M4 11 12 4l8 7"/><path d="M6 10v9.5h12V10"/><path d="M10 19.5v-5h4v5"/>
    {%- when 'grid' -%}<rect x="4" y="4" width="6.5" height="6.5" rx="1"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1"/>
    {%- when 'check' -%}<path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- else -%}<circle cx="12" cy="12" r="8"/>
  {%- endcase -%}
</svg>
