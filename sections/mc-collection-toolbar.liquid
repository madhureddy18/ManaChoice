<style>.mc-collection-tools{display:flex;justify-content:space-between;align-items:end;gap:24px;padding-top:28px;padding-bottom:12px}.mc-collection-tools h1{margin:0;color:#171717;font-size:32px}.mc-collection-tools p:not(.mc-kicker){margin:7px 0 0;color:#6f6f7b;font-size:13px;max-width:650px}.mc-kicker{color:#6c4cff!important;font-size:11px;font-weight:900;letter-spacing:.14em;margin:0 0 7px}.mc-sort{display:flex;align-items:center;gap:9px;white-space:nowrap}.mc-sort label{font-size:12px;font-weight:700;color:#6f6f7b}.mc-sort select{border:1px solid #dddde7;border-radius:7px;background:#fff;padding:10px 28px 10px 11px;font-size:12px}@media(max-width:600px){.mc-collection-tools{display:block;padding-top:20px}.mc-sort{margin-top:15px}.mc-collection-tools h1{font-size:26px}}</style><div class="page-width mc-collection-tools"><div><p class="mc-kicker">SHOP MANA CHOICE</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<p>{{ collection.description | strip_html | truncate: 180 }}</p>{% endif %}</div><div class="mc-sort"><label for="mc-sort">Sort by</label><select id="mc-sort" onchange="if(this.value)location.href=this.value"><option value="{{ collection.url }}?sort_by=best-selling">Best selling</option><option value="{{ collection.url }}?sort_by=created-descending">Newest</option><option value="{{ collection.url }}?sort_by=price-ascending">Price: low to high</option><option value="{{ collection.url }}?sort_by=price-descending">Price: high to low</option></select></div></div>{% schema %}{"name":"ManaChoice collection toolbar","settings":[]}{% endschema %}