<div class="page-width mc-collection-tools"><div><p class="mc-kicker">SHOP MANA CHOICE</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<p>{{ collection.description | strip_html | truncate: 180 }}</p>{% endif %}</div><div class="mc-sort"><label for="mc-sort">Sort by</label><select id="mc-sort" onchange="if(this.value)location.href=this.value"><option value="{{ collection.url }}?sort_by=best-selling">Best selling</option><option value="{{ collection.url }}?sort_by=created-descending">Newest</option><option value="{{ collection.url }}?sort_by=price-ascending">Price: low to high</option><option value="{{ collection.url }}?sort_by=price-descending">Price: high to low</option></select></div></div>{% schema %}{"name":"ManaChoice collection toolbar","settings":[]}{% endschema %}