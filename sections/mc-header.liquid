{{ 'mc-finish.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mc-finish.js' | asset_url }}" defer="defer"></script>
<style>.mc-header{background:#fff;border-bottom:1px solid #e8e8ef;position:relative;z-index:20}.mc-header__trust{background:#6c4cff;color:#fff;font-size:12px;font-weight:700}.mc-header__trust .page-width{min-height:32px;display:flex;justify-content:center;gap:32px;align-items:center}.mc-header__main{display:grid;grid-template-columns:auto minmax(300px,1fr) auto;gap:28px;align-items:center;padding:15px 0}.mc-header__brand{font-size:29px;font-weight:900;letter-spacing:-1.8px;text-decoration:none;color:#171717;white-space:nowrap}.mc-header__brand b{color:#6542e8}.mc-header__search,.mc-header__mobile-search form{display:flex;border:1px solid #dedee8;background:#f6f6f9;border-radius:8px;overflow:hidden;height:46px}.mc-header__search input,.mc-header__mobile-search input{border:0;background:transparent;outline:0;flex:1;padding:0 16px;font-size:14px}.mc-header__search button,.mc-header__mobile-search button{border:0;background:transparent;padding:0 17px;font-size:22px;cursor:pointer}.mc-header__actions{display:flex;gap:20px;align-items:center}.mc-header__actions a{position:relative;color:#171717;text-decoration:none;font-size:13px;font-weight:700;display:flex;gap:6px;align-items:center}.mc-header__actions em{font-style:normal}.mc-header__actions strong{position:absolute;right:-9px;top:-8px;background:#6c4cff;color:#fff;border-radius:99px;font-size:10px;padding:2px 5px}.mc-header__nav{border-top:1px solid #f0f0f4}.mc-header__nav .page-width{display:flex;gap:28px;overflow:auto;scrollbar-width:none}.mc-header__nav a{color:#252530;text-decoration:none;font-size:13px;font-weight:700;padding:13px 0;white-space:nowrap}.mc-header__nav a:hover,.mc-header__nav .mc-header__deals{color:#6c4cff}.mc-header__mobile-search{display:none;padding-bottom:12px}@media(max-width:989px){.mc-header__main{grid-template-columns:auto auto}.mc-header__brand{font-size:25px}.mc-header__search{display:none}.mc-header__actions{gap:13px}.mc-header__actions em{display:none}.mc-header__mobile-search{display:block}.mc-header__nav .page-width{gap:20px}}@media(max-width:600px){.mc-header__trust .page-width{gap:12px;font-size:10px}.mc-header__trust span:nth-child(2){display:none}.mc-header__main{padding:12px 0}.mc-header__brand{font-size:22px;letter-spacing:-1.3px}.mc-header__actions{gap:8px}.mc-header__actions a{font-size:18px}.mc-header__nav a{font-size:12px;padding:11px 0}}</style>
<header class="mc-header"><div class="mc-header__trust"><div class="page-width"><span>🚚 Free shipping on eligible orders</span><span>🔒 Secure payments</span><span>↩ Easy returns</span></div></div><div class="page-width mc-header__main"><a class="mc-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home"><span>Mana</span><b>Choice</b></a><form class="mc-header__search" action="{{ routes.search_url }}" method="get" role="search"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products, brands and more..." aria-label="Search products"><input type="hidden" name="type" value="product"><button type="submit" aria-label="Search">⌕</button></form><nav class="mc-header__actions" aria-label="Account actions"><a href="{{ routes.account_url }}">👤<em>Account</em></a><a href="/pages/wishlist">♡<em>Wishlist</em></a><a href="{{ routes.cart_url }}">🛒<em>Cart</em>{% if cart.item_count > 0 %}<strong>{{ cart.item_count }}</strong>{% endif %}</a></nav></div><div class="page-width mc-header__mobile-search"><form action="{{ routes.search_url }}" method="get" role="search"><input type="search" name="q" placeholder="Search products, brands and more..." aria-label="Search products"><input type="hidden" name="type" value="product"><button type="submit">⌕</button></form></div><nav class="mc-header__nav" aria-label="Main navigation"><div class="page-width"><a href="/collections/all-products">All</a><a href="/collections/electronics">Electronics</a><a href="/collections/fashion">Fashion</a><a href="/collections/home">Home</a><a href="/collections/travel">Travel</a><a href="/collections/gadgets">Gadgets</a><a href="/collections/pets">Pets</a><a class="mc-header__deals" href="/collections/deals">🔥 Deals</a></div></nav></header>
{% schema %}{"name":"ManaChoice header","settings":[]}{% endschema %}