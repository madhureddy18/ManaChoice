{%- liquid
  assign mc_logo = section.settings.logo
-%}
{%- if section.settings.announcement != blank -%}
  <div class="mc-announce">{{ section.settings.announcement | escape }}</div>
{%- endif -%}
<header class="mc-header">
  <div class="mc-container mc-header__bar">
    <form class="mc-search" action="{{ routes.search_url }}" method="get" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products" aria-label="Search products" autocomplete="off">
      <input type="hidden" name="type" value="product">
      <button type="submit" aria-label="Search">{% render 'mc-icon', name: 'search', size: 18 %}</button>
    </form>

    <a class="mc-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      {%- if mc_logo != blank -%}
        <img src="{{ mc_logo | image_url: width: 600 }}" alt="{{ mc_logo.alt | default: shop.name | escape }}" width="{{ mc_logo.width }}" height="{{ mc_logo.height }}" loading="eager">
      {%- else -%}
        <span class="mc-logo__text">Mana<em>Choice</em></span>
      {%- endif -%}
    </a>

    <div class="mc-tools">
      <a class="mc-tool" href="{{ routes.account_url }}" aria-label="Account">{% render 'mc-icon', name: 'user', size: 22 %}</a>
      <a class="mc-tool" href="/pages/wishlist" aria-label="Wishlist">{% render 'mc-icon', name: 'heart', size: 22 %}<span class="mc-count mc-wishlist-count"></span></a>
      <a class="mc-tool" href="{{ routes.cart_url }}" id="cart-icon-bubble" aria-label="Cart">{% render 'mc-icon', name: 'bag', size: 22 %}{% if cart.item_count > 0 %}<span class="mc-count">{{ cart.item_count }}</span>{% endif %}</a>
    </div>
  </div>

  <div class="mc-container mc-header__mobile-search">
    <form class="mc-search" action="{{ routes.search_url }}" method="get" role="search">
      <input type="search" name="q" placeholder="Search products" aria-label="Search products" autocomplete="off">
      <input type="hidden" name="type" value="product">
      <button type="submit" aria-label="Search">{% render 'mc-icon', name: 'search', size: 18 %}</button>
    </form>
  </div>

  <nav class="mc-nav" aria-label="Main navigation">
    <div class="mc-container mc-nav__list">
      {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}">Shop all</a>
        {%- assign mc_n = 0 -%}
        {%- for c in collections limit: 24 -%}
          {%- if c.handle != 'frontpage' and c.handle != 'all' and c.handle != 'all-products' and c.handle != 'deals' and c.products_count > 0 and mc_n < 5 -%}
            {%- assign mc_n = mc_n | plus: 1 -%}
            <a href="{{ c.url }}"{% if collection.handle == c.handle %} aria-current="page"{% endif %}>{{ c.title }}</a>
          {%- endif -%}
        {%- endfor -%}
        {%- if collections.deals.products_count > 0 -%}
          <a class="is-sale" href="{{ collections.deals.url }}">Sale</a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "ManaChoice header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Transparent PNG or SVG works best." },
    { "type": "text", "id": "announcement", "label": "Announcement bar text", "default": "Free shipping on eligible orders  ·  Easy returns" },
    { "type": "link_list", "id": "menu", "label": "Navigation menu", "info": "Optional. Leave empty to build the menu automatically from your collections." }
  ],
  "presets": [{ "name": "ManaChoice header" }]
}
{% endschema %}
