<section class="mc-market-home">
  {% assign all_products_collection = collections[section.settings.featured_collection] %}
  {% assign deals_collection = collections[section.settings.deals_collection] %}
  <div class="mc-market-home__hero page-width"><div class="mc-hero-main"><div class="mc-hero-copy"><span class="mc-pill">MANA CHOICE • TRENDING FINDS</span><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.subheading }}</p><div class="mc-hero-actions"><a class="mc-market-btn mc-market-btn--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a><a class="mc-market-btn mc-market-btn--light" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a></div><div class="mc-hero-points"><span>✓ Secure checkout</span><span>✓ Easy returns</span><span>✓ New products</span></div></div><div class="mc-hero-visual" aria-hidden="true"><div class="mc-float mc-float--one">⚡</div><div class="mc-float mc-float--two">✈️</div><div class="mc-float mc-float--three">🎮</div><div class="mc-hero-stack"><span>SHOP</span><strong>WHAT'S<br>NEW</strong><small>Everyday finds. Better value.</small></div></div></div></div>
  <div class="mc-market-home__section page-width"><div class="mc-section-title"><div><span class="mc-kicker">BROWSE</span><h2>Shop by category</h2></div><a href="{{ section.settings.primary_link }}">View all →</a></div><div class="mc-category-rail"><a href="/collections/all-products" class="mc-cat"><span>🛍️</span><strong>All</strong><small>Everything</small></a><a href="/collections/electronics" class="mc-cat"><span>📱</span><strong>Electronics</strong><small>Tech & accessories</small></a><a href="/collections/fashion" class="mc-cat"><span>👕</span><strong>Fashion</strong><small>Style picks</small></a><a href="/collections/home" class="mc-cat"><span>🏠</span><strong>Home</strong><small>Everyday living</small></a><a href="/collections/travel" class="mc-cat"><span>✈️</span><strong>Travel</strong><small>Travel smarter</small></a><a href="/collections/gadgets" class="mc-cat"><span>🎮</span><strong>Gadgets</strong><small>Fun & useful</small></a><a href="/collections/pets" class="mc-cat"><span>🐾</span><strong>Pets</strong><small>For your pets</small></a><a href="/collections/deals" class="mc-cat mc-cat--deal"><span>🔥</span><strong>Deals</strong><small>Best prices</small></a></div></div>
  {% if deals_collection != blank and deals_collection.products_count > 0 %}<div class="mc-market-home__section page-width"><div class="mc-section-title"><div><span class="mc-kicker mc-kicker--hot">LIMITED TIME</span><h2>Deals of the day</h2></div><a href="{{ deals_collection.url }}">View all deals →</a></div><div class="mc-deal-layout"><a class="mc-deal-banner" href="{{ deals_collection.url }}"><span>🔥 DEAL ZONE</span><strong>Big value.<br>Small prices.</strong><small>Fresh offers across the store</small><em>Shop deals →</em></a><div class="mc-product-grid mc-product-grid--five">{% for product in deals_collection.products limit: 5 %}<article class="mc-home-product"><a href="{{ product.url }}" class="mc-home-product__image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '260,400,600', alt: product.featured_image.alt | default: product.title | escape }}{% else %}<span>No image</span>{% endif %}{% if product.compare_at_price > product.price %}<b>SALE</b>{% endif %}</a><div class="mc-home-product__body">{% if product.vendor != blank %}<small>{{ product.vendor }}</small>{% endif %}<a href="{{ product.url }}">{{ product.title }}</a><div><strong>{{ product.price | money }}</strong>{% if product.compare_at_price > product.price %}<del>{{ product.compare_at_price | money }}</del>{% endif %}</div></div></article>{% endfor %}</div></div></div>{% endif %}
  {% if all_products_collection != blank and all_products_collection.products_count > 0 %}<div class="mc-market-home__section page-width"><div class="mc-section-title"><div><span class="mc-kicker">POPULAR RIGHT NOW</span><h2>Trending picks</h2></div><a href="{{ all_products_collection.url }}">See all products →</a></div><div class="mc-product-grid">{% for product in all_products_collection.products limit: 8 %}<article class="mc-home-product"><a href="{{ product.url }}" class="mc-home-product__image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 650 | image_tag: loading: 'lazy', widths: '280,420,650', alt: product.featured_image.alt | default: product.title | escape }}{% else %}<span>No image</span>{% endif %}{% if product.compare_at_price > product.price %}<b>SALE</b>{% endif %}<button class="mc-wishlist" type="button" aria-label="Add to wishlist" onclick="event.preventDefault();this.classList.toggle('is-active')">♡</button></a><div class="mc-home-product__body">{% if product.vendor != blank %}<small>{{ product.vendor }}</small>{% endif %}<a href="{{ product.url }}">{{ product.title }}</a><div><strong>{{ product.price | money }}</strong>{% if product.compare_at_price > product.price %}<del>{{ product.compare_at_price | money }}</del>{% endif %}</div><a class="mc-quick-add" href="{{ product.url }}">View product</a></div></article>{% endfor %}</div></div>{% endif %}
  <div class="mc-market-home__section page-width"><div class="mc-promo-row"><a href="/collections/electronics" class="mc-promo mc-promo--purple"><span>SMART PICKS</span><strong>Upgrade your<br>everyday tech.</strong><small>Explore electronics →</small></a><a href="/collections/travel" class="mc-promo mc-promo--sand"><span>TRAVEL EDIT</span><strong>Pack smarter.<br>Travel better.</strong><small>Explore travel →</small></a><a href="/collections/pets" class="mc-promo mc-promo--mint"><span>PET PICKS</span><strong>Good things<br>for good pets.</strong><small>Shop pet products →</small></a></div></div>
  <div class="mc-market-home__section page-width"><div class="mc-section-title"><div><span class="mc-kicker">WHY MANA CHOICE</span><h2>Shopping made simple</h2></div></div><div class="mc-trust-grid"><div><span>🚚</span><strong>Reliable delivery</strong><small>Track your order from checkout to doorstep.</small></div><div><span>🔒</span><strong>Secure payments</strong><small>Shop confidently with Shopify-powered checkout.</small></div><div><span>↩</span><strong>Easy returns</strong><small>Simple support when something isn't right.</small></div><div><span>⭐</span><strong>Fresh finds</strong><small>New products and useful discoveries added regularly.</small></div></div></div>
</section>
<style>
.mc-market-home{background:#f7f7fb;padding-bottom:64px;color:#171717}.mc-market-home .page-width{max-width:1400px;margin:0 auto;padding-left:28px;padding-right:28px}.mc-market-home__hero{padding-top:18px}.mc-hero-main{min-height:430px;border-radius:18px;overflow:hidden;background:linear-gradient(115deg,#25155f 0%,#6245e8 62%,#8d78ff 100%);display:grid;grid-template-columns:1.15fr .85fr;align-items:center;color:#fff;position:relative}.mc-hero-main:after{content:"";position:absolute;width:430px;height:430px;border-radius:50%;right:-120px;top:-210px;background:rgba(255,255,255,.08)}.mc-hero-copy{padding:52px 20px 52px 58px;position:relative;z-index:2}.mc-pill{display:inline-block;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.1);border-radius:999px;padding:8px 12px;font-size:10px;font-weight:900;letter-spacing:.12em}.mc-hero-copy h1{font-size:clamp(38px,4.4vw,62px);line-height:.99;letter-spacing:-2.5px;max-width:720px;margin:17px 0 16px}.mc-hero-copy p{font-size:17px;line-height:1.55;max-width:610px;margin:0 0 24px;color:rgba(255,255,255,.88)}.mc-hero-actions{display:flex;gap:10px;flex-wrap:wrap}.mc-market-btn{display:inline-flex;text-decoration:none;font-weight:850;border-radius:8px;padding:13px 20px}.mc-market-btn--primary{background:#fff;color:#29186f}.mc-market-btn--light{border:1px solid rgba(255,255,255,.5);color:#fff;background:rgba(255,255,255,.08)}.mc-hero-points{display:flex;gap:18px;flex-wrap:wrap;margin-top:22px;font-size:11px;font-weight:700;color:rgba(255,255,255,.8)}.mc-hero-visual{height:100%;min-height:380px;display:grid;place-items:center;position:relative;z-index:1}.mc-hero-stack{width:250px;height:280px;border-radius:26px;background:linear-gradient(145deg,#fff,#ece9ff);color:#25145f;display:flex;flex-direction:column;justify-content:center;padding:30px;box-shadow:0 30px 70px rgba(15,5,55,.25);transform:rotate(5deg)}.mc-hero-stack span{font-size:11px;font-weight:900;letter-spacing:.16em}.mc-hero-stack strong{font-size:39px;line-height:.92;margin:12px 0}.mc-hero-stack small{font-size:12px;color:#655c82}.mc-float{position:absolute;width:58px;height:58px;border-radius:18px;background:#fff;display:grid;place-items:center;font-size:27px;box-shadow:0 16px 30px rgba(0,0,0,.15)}.mc-float--one{top:23%;left:12%}.mc-float--two{bottom:18%;left:18%}.mc-float--three{top:17%;right:15%}.mc-market-home__section{margin-top:42px}.mc-section-title{display:flex;justify-content:space-between;align-items:end;margin-bottom:18px;gap:20px}.mc-section-title h2{font-size:28px;line-height:1.1;margin:2px 0 0;letter-spacing:-.7px}.mc-section-title>a{font-size:13px;font-weight:850;color:#6547e8;text-decoration:none;white-space:nowrap}.mc-kicker{font-size:10px;font-weight:900;letter-spacing:.14em;color:#6c4cff}.mc-kicker--hot{color:#e14b55}.mc-category-rail{display:grid;grid-template-columns:repeat(8,1fr);gap:10px}.mc-cat{min-height:122px;background:#fff;border:1px solid #e5e5ed;border-radius:13px;padding:16px;text-decoration:none;color:#171717;display:flex;flex-direction:column;justify-content:center;transition:.18s}.mc-cat:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(30,20,80,.08)}.mc-cat span{font-size:28px;margin-bottom:8px}.mc-cat strong{font-size:13px}.mc-cat small{font-size:10px;color:#777;margin-top:4px}.mc-cat--deal{background:#fff4f4;border-color:#ffdada}.mc-deal-layout{display:grid;grid-template-columns:220px 1fr;gap:14px}.mc-deal-banner{border-radius:15px;padding:22px;text-decoration:none;color:#fff;background:linear-gradient(150deg,#ed4d5a,#a81d3a);display:flex;flex-direction:column;justify-content:space-between;min-height:390px}.mc-deal-banner span{font-size:10px;font-weight:900;letter-spacing:.13em}.mc-deal-banner strong{font-size:30px;line-height:1.02}.mc-deal-banner small{font-size:11px;opacity:.82}.mc-deal-banner em{font-style:normal;font-weight:850;font-size:12px}.mc-product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.mc-product-grid--five{grid-template-columns:repeat(5,minmax(0,1fr))}.mc-home-product{background:#fff;border:1px solid #e6e6ee;border-radius:13px;overflow:hidden;min-width:0}.mc-home-product__image{display:block;position:relative;aspect-ratio:1/1;background:#f1f1f5;overflow:hidden;text-decoration:none}.mc-home-product__image img{width:100%;height:100%;object-fit:cover;display:block;transition:.2s}.mc-home-product:hover .mc-home-product__image img{transform:scale(1.025)}.mc-home-product__image>b{position:absolute;left:9px;top:9px;background:#e84b57;color:#fff;border-radius:5px;padding:5px 7px;font-size:9px}.mc-home-product__image>span{height:100%;display:grid;place-items:center;color:#888}.mc-wishlist{position:absolute;right:9px;top:9px;width:33px;height:33px;border:0;border-radius:50%;background:#fff;font-size:18px;cursor:pointer;box-shadow:0 3px 12px rgba(0,0,0,.1)}.mc-wishlist.is-active{color:#6c4cff}.mc-home-product__body{padding:12px}.mc-home-product__body>small{display:block;font-size:9px;text-transform:uppercase;letter-spacing:.08em;color:#888;margin-bottom:5px}.mc-home-product__body>a:not(.mc-quick-add){display:block;text-decoration:none;color:#171717;font-size:13px;font-weight:650;line-height:1.35;min-height:36px}.mc-home-product__body div{margin-top:9px}.mc-home-product__body strong{font-size:15px}.mc-home-product__body del{font-size:11px;color:#999;margin-left:6px}.mc-quick-add{display:block;text-align:center;margin-top:10px;border-radius:7px;padding:8px;background:#6c4cff;color:#fff;text-decoration:none;font-size:11px;font-weight:850}.mc-promo-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.mc-promo{min-height:170px;border-radius:16px;padding:25px;text-decoration:none;display:flex;flex-direction:column;justify-content:space-between}.mc-promo span{font-size:10px;font-weight:900;letter-spacing:.13em}.mc-promo strong{font-size:26px;line-height:1.02}.mc-promo small{font-weight:800;font-size:11px}.mc-promo--purple{background:#e9e4ff;color:#2d206c}.mc-promo--sand{background:#fff0d8;color:#69421e}.mc-promo--mint{background:#ddf5ed;color:#185b4a}.mc-trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.mc-trust-grid>div{background:#fff;border:1px solid #e6e6ee;border-radius:13px;padding:18px;display:grid;grid-template-columns:auto 1fr;column-gap:11px}.mc-trust-grid span{grid-row:span 2;font-size:25px}.mc-trust-grid strong{font-size:13px}.mc-trust-grid small{font-size:10px;color:#777;line-height:1.45;margin-top:4px}@media(max-width:1100px){.mc-category-rail{grid-template-columns:repeat(4,1fr)}.mc-product-grid--five{grid-template-columns:repeat(3,1fr)}.mc-deal-layout{grid-template-columns:190px 1fr}}@media(max-width:989px){.mc-hero-main{grid-template-columns:1fr}.mc-hero-copy{padding:40px 30px}.mc-hero-visual{min-height:270px}.mc-product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.mc-product-grid--five{grid-template-columns:repeat(2,minmax(0,1fr))}.mc-deal-layout{grid-template-columns:1fr}.mc-deal-banner{min-height:190px}.mc-promo-row{grid-template-columns:1fr}.mc-trust-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.mc-market-home .page-width{padding-left:14px;padding-right:14px}.mc-market-home__hero{padding-top:10px}.mc-hero-main{min-height:0;border-radius:13px}.mc-hero-copy{padding:28px 20px}.mc-hero-copy h1{font-size:37px;letter-spacing:-1.5px}.mc-hero-copy p{font-size:14px}.mc-hero-points{gap:8px;font-size:9px}.mc-hero-visual{min-height:230px}.mc-hero-stack{width:170px;height:185px;padding:22px}.mc-hero-stack strong{font-size:28px}.mc-float{width:46px;height:46px;font-size:21px}.mc-category-rail{display:flex;overflow-x:auto;gap:8px;padding-bottom:4px;scrollbar-width:none}.mc-cat{min-width:108px;min-height:105px;padding:13px}.mc-section-title h2{font-size:22px}.mc-section-title>a{font-size:11px}.mc-product-grid,.mc-product-grid--five{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.mc-home-product__body{padding:10px}.mc-home-product__body>a:not(.mc-quick-add){font-size:12px}.mc-home-product__body strong{font-size:14px}.mc-quick-add{font-size:10px}.mc-deal-banner{min-height:170px}.mc-promo{min-height:145px;padding:20px}.mc-promo strong{font-size:22px}.mc-trust-grid{grid-template-columns:1fr}.mc-market-home__section{margin-top:30px}}
