<section class="mc-home page-width">
  <div class="mc-home__hero">
    <div class="mc-home__hero-copy">
      <span class="mc-eyebrow">MANA CHOICE MARKETPLACE</span>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
      <div class="mc-hero-actions">
        <a class="mc-btn mc-btn--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
        <a class="mc-btn mc-btn--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
      </div>
    </div>
    <div class="mc-home__hero-art" aria-hidden="true">
      <div class="mc-orbit mc-orbit--one">⚡</div>
      <div class="mc-orbit mc-orbit--two">✈️</div>
      <div class="mc-orbit mc-orbit--three">🎮</div>
      <div class="mc-hero-badge">New finds<br><strong>Everyday value</strong></div>
    </div>
  </div>

  <div class="mc-home__section">
    <div class="mc-section-head"><h2>{{ section.settings.categories_heading }}</h2></div>
    <div class="mc-category-grid">
      {% for block in section.blocks %}
        <a class="mc-category-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <span class="mc-category-card__icon">{{ block.settings.icon }}</span>
          <strong>{{ block.settings.title }}</strong>
          <small>{{ block.settings.subtitle }}</small>
        </a>
      {% endfor %}
    </div>
  </div>

  {% assign featured_collection = collections[section.settings.featured_collection] %}
  {% if featured_collection != blank and featured_collection.products_count > 0 %}
    <div class="mc-home__section">
      <div class="mc-section-head">
        <div><span class="mc-eyebrow">TRENDING NOW</span><h2>{{ section.settings.featured_heading }}</h2></div>
        <a href="{{ featured_collection.url }}">View all →</a>
      </div>
      <div class="mc-product-grid">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          <div class="mc-product-card">
            <a href="{{ product.url }}" class="mc-product-card__image">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '280,420,560,700', alt: product.featured_image.alt | escape }}
              {% else %}<div class="mc-product-card__placeholder">No image</div>{% endif %}
            </a>
            <div class="mc-product-card__body">
              {% if product.vendor != blank %}<span class="mc-product-card__vendor">{{ product.vendor }}</span>{% endif %}
              <a href="{{ product.url }}" class="mc-product-card__title">{{ product.title }}</a>
              <div class="mc-product-card__price">{{ product.price | money }}</div>
              {% if product.compare_at_price > product.price %}
                <span class="mc-product-card__sale">Sale</span>
              {% endif %}
              <a class="mc-product-card__cart" href="{{ product.url }}">View product</a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="mc-home__deal">
    <div><span class="mc-eyebrow">VALUE PICKS</span><h2>{{ section.settings.deal_heading }}</h2><p>{{ section.settings.deal_text }}</p></div>
    <a class="mc-btn mc-btn--primary" href="{{ section.settings.deal_link }}">Shop deals</a>
  </div>

  <div class="mc-benefit-grid">
    <div><strong>🚚 Reliable delivery</strong><span>Track your order from checkout to doorstep.</span></div>
    <div><strong>🔒 Secure checkout</strong><span>Shop with trusted Shopify-powered payments.</span></div>
    <div><strong>↩ Easy returns</strong><span>Simple support when something isn't right.</span></div>
    <div><strong>⭐ New discoveries</strong><span>Fresh products added across categories.</span></div>
  </div>
</section>

{% schema %}
{
  "name": "ManaChoice marketplace home",
  "settings": [
    {"type":"text","id":"heading","label":"Hero heading","default":"Discover things you'll wish you found sooner."},
    {"type":"textarea","id":"subheading","label":"Hero subheading","default":"Trending finds, everyday essentials and products worth discovering — all in one place."},
    {"type":"text","id":"primary_label","label":"Primary button","default":"Shop all"},
    {"type":"url","id":"primary_link","label":"Primary link"},
    {"type":"text","id":"secondary_label","label":"Secondary button","default":"Explore deals"},
    {"type":"url","id":"secondary_link","label":"Secondary link"},
    {"type":"text","id":"categories_heading","label":"Categories heading","default":"Shop by category"},
    {"type":"text","id":"featured_heading","label":"Products heading","default":"Popular picks"},
    {"type":"collection","id":"featured_collection","label":"Featured collection"},
    {"type":"range","id":"products_to_show","label":"Products to show","min":4,"max":12,"step":2,"default":8},
    {"type":"text","id":"deal_heading","label":"Deal heading","default":"Good products. Better prices."},
    {"type":"textarea","id":"deal_text","label":"Deal text","default":"Find limited-time offers and everyday value across the store."},
    {"type":"url","id":"deal_link","label":"Deal link"}
  ],
  "blocks": [
    {"type":"category","name":"Category","settings":[{"type":"text","id":"icon","label":"Icon","default":"⚡"},{"type":"text","id":"title","label":"Title","default":"Electronics"},{"type":"text","id":"subtitle","label":"Subtitle","default":"Smart tech & accessories"},{"type":"url","id":"link","label":"Link"}]}
  ],
  "presets": [
    {"name":"ManaChoice marketplace home","blocks":[{"type":"category","settings":{"icon":"⚡","title":"Electronics","subtitle":"Smart tech & accessories"}},{"type":"category","settings":{"icon":"👕","title":"Fashion","subtitle":"Everyday styles & picks"}},{"type":"category","settings":{"icon":"🏠","title":"Home & Living","subtitle":"Useful things for home"}},{"type":"category","settings":{"icon":"✈️","title":"Travel","subtitle":"Travel smarter"}},{"type":"category","settings":{"icon":"🎮","title":"Gadgets","subtitle":"Fun & useful tech"}},{"type":"category","settings":{"icon":"🐾","title":"Pets","subtitle":"For your furry friends"}}]}
  ]
}
{% endschema %}