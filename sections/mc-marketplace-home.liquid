<section class="mc-market-home">
{% assign all_products_collection = collections[section.settings.featured_collection] %}
{% assign deals_collection = collections[section.settings.deals_collection] %}
<div class="mc-editorial-hero">
<div class="mc-editorial-hero__media">{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '900,1400,1800,2400', sizes: '100vw', alt: section.settings.hero_heading | escape }}{% else %}<div class="mc-editorial-hero__placeholder"><span>YOUR NEXT<br>FAVORITE FIND</span></div>{% endif %}</div>
<div class="mc-editorial-hero__content"><span class="mc-eyebrow">{{ section.settings.hero_eyebrow }}</span><h1>{{ section.settings.hero_heading }}</h1><p>{{ section.settings.hero_subheading }}</p><a class="mc-editorial-btn" href="{{ section.settings.hero_link }}">{{ section.settings.hero_button }}</a></div>
</div>
<div class="page-width">
<section class="mc-editorial-section mc-category-section"><div class="mc-heading-row"><div><span class="mc-eyebrow">THE EDIT</span><h2>Shop by category</h2></div><a href="/collections/all-products">Explore all →</a></div>
<div class="mc-category-grid">
<a href="/collections/fashion" class="mc-category-card mc-category-card--tall">{% if section.settings.category_1_image != blank %}{{ section.settings.category_1_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Fashion' }}{% endif %}<span><small>01</small><strong>Fashion</strong><em>Style picks →</em></span></a>
<a href="/collections/electronics" class="mc-category-card">{% if section.settings.category_2_image != blank %}{{ section.settings.category_2_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Tech' }}{% endif %}<span><small>02</small><strong>Tech & Accessories</strong><em>Smart picks →</em></span></a>
<a href="/collections/home" class="mc-category-card">{% if section.settings.category_3_image != blank %}{{ section.settings.category_3_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Home' }}{% endif %}<span><small>03</small><strong>Home & Living</strong><em>Everyday pieces →</em></span></a>
<a href="/collections/travel" class="mc-category-card">{% if section.settings.category_4_image != blank %}{{ section.settings.category_4_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Travel' }}{% endif %}<span><small>04</small><strong>Travel</strong><em>Pack better →</em></span></a>
</div></section>
{% if all_products_collection != blank and all_products_collection.products_count > 0 %}
<section class="mc-editorial-section"><div class="mc-heading-row"><div><span class="mc-eyebrow">POPULAR RIGHT NOW</span><h2>Trending now</h2></div><a href="{{ all_products_collection.url }}">View all →</a></div>
<div class="mc-product-grid">
{% for product in all_products_collection.products limit: 8 %}
<article class="mc-product-card"><a href="{{ product.url }}" class="mc-product-card__media">
{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '420,650,900', sizes: '(min-width: 1100px) 25vw, 50vw', alt: product.featured_image.alt | default: product.title | escape }}{% endif %}
{% if product.media.size > 1 and product.media[1].preview_image %}{{ product.media[1].preview_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '420,650,900', sizes: '(min-width: 1100px) 25vw, 50vw', alt: product.title | escape, class: 'mc-product-card__hover' }}{% endif %}
<button class="mc-product-card__wish" type="button" data-mc-wishlist data-product-id="{{ product.id }}" data-product-url="{{ product.url }}" data-product-title="{{ product.title | escape }}" data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 600 }}{% endif %}" data-product-price-cents="{{ product.selected_or_first_available_variant.price }}" aria-label="Add {{ product.title | escape }} to wishlist" aria-pressed="false" onclick="event.preventDefault();event.stopPropagation()">♡</button>
{% if product.compare_at_price > product.price %}<span class="mc-product-card__sale">SALE</span>{% endif %}
</a><div class="mc-product-card__info"><a href="{{ product.url }}">{{ product.title }}</a><div><strong data-mc-price-cents="{{ product.price }}">{{ product.price | money }}</strong>{% if product.compare_at_price > product.price %}<del data-mc-compare-cents="{{ product.compare_at_price }}">{{ product.compare_at_price | money }}</del>{% endif %}</div></div></article>
{% endfor %}</div></section>
{% endif %}
{% if deals_collection != blank and deals_collection.products_count > 0 %}
<section class="mc-editorial-section mc-feature-story"><div class="mc-feature-story__media">{% if section.settings.story_image != blank %}{{ section.settings.story_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '900,1200,1600,1800', sizes: '(min-width: 990px) 58vw, 100vw', alt: section.settings.story_heading | escape }}{% else %}<div class="mc-feature-story__placeholder"><span>THE WEEKEND<br>EDIT</span></div>{% endif %}</div><div class="mc-feature-story__copy"><span class="mc-eyebrow">THE WEEKEND EDIT</span><h2>{{ section.settings.story_heading }}</h2><p>{{ section.settings.story_text }}</p><a class="mc-editorial-text-link" href="{{ deals_collection.url }}">{{ section.settings.story_button }} →</a></div></section>
<section class="mc-editorial-section"><div class="mc-heading-row"><div><span class="mc-eyebrow">LIMITED PICKS</span><h2>Worth a closer look</h2></div><a href="{{ deals_collection.url }}">Shop sale →</a></div><div class="mc-product-grid mc-product-grid--four">
{% for product in deals_collection.products limit: 4 %}<article class="mc-product-card"><a href="{{ product.url }}" class="mc-product-card__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '420,650,900', sizes: '(min-width: 1100px) 25vw, 50vw', alt: product.featured_image.alt | default: product.title | escape }}{% endif %}<button class="mc-product-card__wish" type="button" data-mc-wishlist data-product-id="{{ product.id }}" data-product-url="{{ product.url }}" data-product-title="{{ product.title | escape }}" data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 600 }}{% endif %}" data-product-price-cents="{{ product.selected_or_first_available_variant.price }}" aria-label="Add {{ product.title | escape }} to wishlist" aria-pressed="false" onclick="event.preventDefault();event.stopPropagation()">♡</button>{% if product.compare_at_price > product.price %}<span class="mc-product-card__sale">SALE</span>{% endif %}</a><div class="mc-product-card__info"><a href="{{ product.url }}">{{ product.title }}</a><div><strong data-mc-price-cents="{{ product.price }}">{{ product.price | money }}</strong>{% if product.compare_at_price > product.price %}<del data-mc-compare-cents="{{ product.compare_at_price }}">{{ product.compare_at_price | money }}</del>{% endif %}</div></div></article>{% endfor %}</div></section>
{% endif %}
<section class="mc-editorial-section mc-trust-section"><div class="mc-heading-row"><div><span class="mc-eyebrow">WHY MANA CHOICE</span><h2>Good shopping, without the noise.</h2></div></div><div class="mc-trust-grid"><div><strong>Secure checkout</strong><span>Protected payments and a simple path to purchase.</span></div><div><strong>Easy returns</strong><span>Clear support when something is not right.</span></div><div><strong>Fresh finds</strong><span>New useful pieces and trend-led products added regularly.</span></div><div><strong>Made to discover</strong><span>Less scrolling. Better curation.</span></div></div></section>
</div></section>
<style>
.mc-market-home{background:#fff;color:#111;padding-bottom:70px}.mc-market-home .page-width{max-width:1380px;margin:0 auto;padding:0 28px}
.mc-editorial-hero{position:relative;min-height:calc(100vh - 78px);max-height:820px;display:flex;align-items:flex-end;overflow:hidden;background:#ece8df}.mc-editorial-hero__media,.mc-editorial-hero__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.mc-editorial-hero__media:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0) 34%,rgba(0,0,0,.5) 100%)}.mc-editorial-hero__placeholder{position:absolute;inset:0;display:grid;place-items:center;background:#e8e2d7;font-size:clamp(52px,9vw,120px);font-weight:800;line-height:.88;letter-spacing:-.06em;text-align:center}.mc-editorial-hero__content{position:relative;z-index:2;color:#fff;max-width:720px;padding:clamp(36px,7vw,90px) max(28px,5vw)}.mc-eyebrow{display:block;font-size:10px;line-height:1;letter-spacing:.17em;text-transform:uppercase;font-weight:800;margin-bottom:12px}.mc-editorial-hero h1{font-size:clamp(46px,7vw,92px);line-height:.92;letter-spacing:-.045em;margin:0 0 18px;max-width:650px}.mc-editorial-hero p{font-size:16px;line-height:1.55;max-width:520px;margin:0 0 25px}.mc-editorial-btn{display:inline-flex;background:#fff;color:#111;padding:13px 20px;text-decoration:none;font-size:12px;font-weight:800}
.mc-editorial-section{padding-top:76px}.mc-heading-row{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.mc-heading-row h2{font-size:32px;line-height:1;letter-spacing:-.035em;margin:0}.mc-heading-row>a{color:#111;text-decoration:none;border-bottom:1px solid #111;font-size:11px;font-weight:700;padding-bottom:4px;white-space:nowrap}
.mc-category-grid{display:grid;grid-template-columns:1.15fr .85fr .85fr .85fr;gap:12px}.mc-category-card{position:relative;min-height:330px;background:#e8e3da;overflow:hidden;text-decoration:none;color:#fff}.mc-category-card--tall{min-height:470px}.mc-category-card:after{content:"";position:absolute;inset:45% 0 0;background:linear-gradient(180deg,transparent,rgba(0,0,0,.48))}.mc-category-card img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .45s ease}.mc-category-card:hover img{transform:scale(1.035)}.mc-category-card>span{position:absolute;z-index:2;left:18px;right:18px;bottom:16px;display:grid;grid-template-columns:auto 1fr;column-gap:9px;align-items:end}.mc-category-card small{font-size:9px;grid-row:span 3;align-self:start;opacity:.8}.mc-category-card strong{font-size:21px;line-height:1.05}.mc-category-card em{font-style:normal;font-size:10px;margin-top:5px}
.mc-product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}.mc-product-card{min-width:0}.mc-product-card__media{display:block;position:relative;background:#f2f1ee;aspect-ratio:4/5;overflow:hidden;text-decoration:none}.mc-product-card__media img{width:100%;height:100%;object-fit:cover;display:block;transition:opacity .2s ease,transform .35s ease}.mc-product-card__media .mc-product-card__hover{position:absolute;inset:0;opacity:0}.mc-product-card:hover .mc-product-card__hover{opacity:1}.mc-product-card:hover .mc-product-card__media>img:first-child{opacity:0}.mc-product-card:hover .mc-product-card__media>img{transform:scale(1.018)}.mc-product-card__wish{position:absolute;right:10px;top:10px;width:34px;height:34px;border:0;background:rgba(255,255,255,.93);border-radius:50%;font-size:18px;line-height:1;cursor:pointer;z-index:3}.mc-product-card__sale{position:absolute;left:10px;top:10px;background:#111;color:#fff;padding:6px 8px;font-size:9px;font-weight:800;letter-spacing:.08em}.mc-product-card__info{padding-top:11px}.mc-product-card__info>a{display:block;color:#111;text-decoration:none;font-size:12px;line-height:1.35;min-height:32px}.mc-product-card__info div{margin-top:6px}.mc-product-card__info strong{font-size:12px}.mc-product-card__info del{font-size:10px;color:#8b8b8b;margin-left:5px}
.mc-feature-story{display:grid;grid-template-columns:1.55fr .85fr;min-height:520px;background:#f3f1eb}.mc-feature-story__media{min-height:520px;background:#ddd6ca}.mc-feature-story__media img{width:100%;height:100%;object-fit:cover;display:block}.mc-feature-story__placeholder{height:100%;display:grid;place-items:center;font-size:50px;font-weight:800;letter-spacing:-.04em;text-align:center;line-height:.92}.mc-feature-story__copy{display:flex;flex-direction:column;justify-content:center;padding:50px}.mc-feature-story__copy h2{font-size:46px;line-height:.95;letter-spacing:-.05em;margin:0 0 16px}.mc-feature-story__copy p{font-size:14px;line-height:1.6;color:#535353;max-width:360px;margin:0 0 24px}.mc-editorial-text-link{color:#111;text-decoration:none;font-size:11px;font-weight:800;border-bottom:1px solid #111;width:max-content;padding-bottom:5px}
.mc-trust-section{padding-bottom:10px}.mc-trust-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #ddd;border-bottom:1px solid #ddd}.mc-trust-grid>div{padding:22px 16px;min-height:126px;border-right:1px solid #ddd}.mc-trust-grid>div:last-child{border-right:0}.mc-trust-grid strong{display:block;font-size:12px;margin-bottom:9px}.mc-trust-grid span{display:block;color:#6d6d6d;font-size:11px;line-height:1.5}
@media(max-width:1100px){.mc-category-grid{grid-template-columns:repeat(2,1fr)}.mc-category-card,.mc-category-card--tall{min-height:360px}.mc-product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.mc-trust-grid{grid-template-columns:repeat(2,1fr)}.mc-trust-grid>div:nth-child(2){border-right:0}.mc-trust-grid>div:nth-child(-n+2){border-bottom:1px solid #ddd}}
@media(max-width:989px){.mc-editorial-hero{min-height:72vh}.mc-feature-story{grid-template-columns:1fr}.mc-feature-story__media{min-height:420px}.mc-feature-story__copy{padding:40px 30px}}
@media(max-width:700px){.mc-market-home .page-width{padding:0 14px}.mc-editorial-hero{min-height:74vh}.mc-editorial-hero__content{padding:30px 20px}.mc-editorial-hero h1{font-size:44px}.mc-editorial-hero p{font-size:13px}.mc-editorial-section{padding-top:52px}.mc-heading-row h2{font-size:25px}.mc-category-grid{grid-template-columns:repeat(2,1fr);gap:8px}.mc-category-card,.mc-category-card--tall{min-height:250px}.mc-category-card strong{font-size:16px}.mc-category-card>span{left:12px;right:12px;bottom:12px}.mc-product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:15px 9px}.mc-product-card__info>a{font-size:11px}.mc-feature-story__media{min-height:300px}.mc-feature-story__copy{padding:30px 20px}.mc-feature-story__copy h2{font-size:37px}.mc-trust-grid{grid-template-columns:1fr}.mc-trust-grid>div{border-right:0!important;border-bottom:1px solid #ddd}.mc-trust-grid>div:last-child{border-bottom:0}}
</style>
{% schema %}{"name":"ManaChoice editorial home","settings":[{"type":"text","id":"hero_eyebrow","label":"Hero eyebrow","default":"NEW SEASON · EVERYDAY EDIT"},{"type":"text","id":"hero_heading","label":"Hero heading","default":"Make everyday better."},{"type":"textarea","id":"hero_subheading","label":"Hero subheading","default":"Useful, good-looking finds for the way you live, work and move."},{"type":"text","id":"hero_button","label":"Hero button","default":"SHOP NEW"},{"type":"url","id":"hero_link","label":"Hero link"},{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"image_picker","id":"category_1_image","label":"Fashion image"},{"type":"image_picker","id":"category_2_image","label":"Tech image"},{"type":"image_picker","id":"category_3_image","label":"Home image"},{"type":"image_picker","id":"category_4_image","label":"Travel image"},{"type":"image_picker","id":"story_image","label":"Editorial story image"},{"type":"text","id":"story_heading","label":"Story heading","default":"Things worth taking with you."},{"type":"textarea","id":"story_text","label":"Story text","default":"A small edit of useful pieces, smart accessories and easy upgrades for the weekend and beyond."},{"type":"text","id":"story_button","label":"Story link label","default":"EXPLORE THE EDIT"},{"type":"collection","id":"featured_collection","label":"Trending collection"},{"type":"collection","id":"deals_collection","label":"Deals collection"}],"presets":[{"name":"ManaChoice editorial home"}]}{% endschema %}