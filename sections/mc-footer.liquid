<footer class="mc-footer">
  <div class="mc-container mc-footer__grid">
    <div class="mc-footer__col mc-footer__col--brand">
      <a class="mc-footer__brand" href="{{ routes.root_url }}">Mana<em>Choice</em></a>
      {%- if section.settings.about != blank -%}<p class="mc-footer__about">{{ section.settings.about | escape }}</p>{%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="mc-news">
          {%- form 'customer', id: 'mc-newsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="mc-news__label" for="mc-news-email">{{ section.settings.newsletter_heading | escape }}</label>
            <div class="mc-news__row">
              <input id="mc-news-email" type="email" name="contact[email]" value="{{ form.email }}" placeholder="Your email address" autocomplete="email" required aria-required="true">
              <button type="submit">Subscribe</button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="mc-news__msg" role="status">Thank you for subscribing.</p>
            {%- endif -%}
            {%- if form.errors -%}
              <p class="mc-news__msg mc-news__msg--error" role="alert">Please enter a valid email address.</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      {%- liquid
        assign mc_social = false
        if settings.social_instagram_link != blank or settings.social_facebook_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank or settings.social_twitter_link != blank or settings.social_pinterest_link != blank
          assign mc_social = true
        endif
      -%}
      {%- if mc_social -%}
        <div class="mc-footer__social">
          {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
          {%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
          {%- if settings.social_youtube_link != blank -%}<a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener">YouTube</a>{%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}<a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
          {%- if settings.social_twitter_link != blank -%}<a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener">X / Twitter</a>{%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}<a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener">Pinterest</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="mc-footer__col">
      <h3>Shop</h3>
      <ul class="mc-footer__links" role="list">
        {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
          {%- for link in section.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
        {%- else -%}
          <li><a href="{{ routes.all_products_collection_url }}">All products</a></li>
          {%- assign mc_n = 0 -%}
          {%- for c in collections limit: 24 -%}
            {%- if c.handle != 'frontpage' and c.handle != 'all' and c.handle != 'all-products' and c.products_count > 0 and mc_n < 5 -%}
              {%- assign mc_n = mc_n | plus: 1 -%}
              <li><a href="{{ c.url }}">{{ c.title }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>

    <div class="mc-footer__col">
      <h3>Help</h3>
      <ul class="mc-footer__links" role="list">
        <li><a href="/pages/contact">Contact us</a></li>
        {%- for policy in shop.policies -%}
          {%- if policy.url != blank -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endif -%}
        {%- endfor -%}
        <li><a href="/pages/wishlist">Wishlist</a></li>
        <li><a href="{{ routes.cart_url }}">Cart</a></li>
      </ul>
    </div>
  </div>

  <div class="mc-container mc-footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.</span>
    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="mc-pay" role="list">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "ManaChoice footer",
  "settings": [
    { "type": "textarea", "id": "about", "label": "About text", "default": "Discover things you'll wish you found sooner. A curated mix of fashion, tech, home and everyday finds." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Get new arrivals and offers in your inbox" },
    { "type": "link_list", "id": "menu", "label": "Shop links", "info": "Optional. Leave empty to list your collections automatically." }
  ]
}
{% endschema %}
