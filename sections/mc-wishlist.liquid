<section class="mc-wishlist-page mc-container" data-mc-wishlist-page>
  <div class="mc-wishlist-page__head">
    <div>
      <p class="mc-kicker">Saved for later</p>
      <h1>My wishlist</h1>
      <p>Save products you want to come back to.</p>
    </div>
    <span class="mc-wishlist-page__total" data-mc-wishlist-total>0 items</span>
  </div>

  <div class="mc-wishlist-grid" data-mc-wishlist-grid></div>

  <div class="mc-wishlist-empty" data-mc-wishlist-empty hidden>
    <div class="mc-wishlist-empty__icon" aria-hidden="true">{% render 'mc-icon', name: 'heart', size: 28 %}</div>
    <h2>Your wishlist is empty</h2>
    <p>Tap the heart on any product to save it here.</p>
    <a href="{{ routes.all_products_collection_url }}" class="mc-btn">Shop products</a>
  </div>
</section>

{% schema %}
{
  "name": "ManaChoice wishlist",
  "settings": []
}
{% endschema %}
