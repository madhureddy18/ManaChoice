<section class="mc-wishlist-page page-width" data-mc-wishlist-page>
  <div class="mc-wishlist-page__head">
    <div>
      <span class="mc-wishlist-page__eyebrow">MANA CHOICE</span>
      <h1>My Wishlist</h1>
      <p>Save products you want to come back to.</p>
    </div>
    <span class="mc-wishlist-page__total" data-mc-wishlist-total>0 items</span>
  </div>

  <div class="mc-wishlist-grid" data-mc-wishlist-grid></div>

  <div class="mc-wishlist-empty" data-mc-wishlist-empty hidden>
    <div class="mc-wishlist-empty__icon">♡</div>
    <h2>Your wishlist is empty</h2>
    <p>Tap the heart on any product to save it here.</p>
    <a href="/collections/all-products" class="button button--primary">Shop products</a>
  </div>
</section>

<style>
.mc-wishlist-page{padding-top:42px;padding-bottom:70px}.mc-wishlist-page__head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:28px}.mc-wishlist-page__eyebrow{font-size:1rem;font-weight:800;letter-spacing:.12em;color:rgb(var(--color-button))}.mc-wishlist-page h1{margin:.4rem 0 .6rem;font-size:clamp(3rem,5vw,4.8rem)}.mc-wishlist-page__head p{margin:0;color:rgba(var(--color-foreground),.65)}.mc-wishlist-page__total{font-weight:700;color:rgba(var(--color-foreground),.65)}.mc-wishlist-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.mc-wl-card{border:1px solid rgba(var(--color-foreground),.12);border-radius:14px;overflow:hidden;background:rgb(var(--color-background))}.mc-wl-card__image{position:relative;aspect-ratio:1;background:rgba(var(--color-foreground),.04)}.mc-wl-card__image img{width:100%;height:100%;object-fit:cover;display:block}.mc-wl-card__no-image{height:100%;display:grid;place-items:center;color:rgba(var(--color-foreground),.5)}.mc-wl-card__remove{position:absolute;right:10px;top:10px;width:34px;height:34px;border:0;border-radius:50%;background:#fff;box-shadow:0 2px 10px rgba(0,0,0,.12);font-size:22px;cursor:pointer}.mc-wl-card__body{padding:14px}.mc-wl-card__title{display:block;color:rgb(var(--color-foreground));text-decoration:none;font-weight:650;line-height:1.35;min-height:3.6rem}.mc-wl-card__price{margin-top:9px;font-weight:800;font-size:1.6rem;min-height:2rem}.mc-wl-card__actions{display:flex;gap:8px;margin-top:12px}.mc-wl-card__actions a,.mc-wl-card__actions button{flex:1;text-align:center;padding:9px 8px;border-radius:7px;text-decoration:none;font:inherit;font-size:1.2rem;font-weight:700}.mc-wl-card__actions a{background:rgb(var(--color-button));color:rgb(var(--color-button-text))}.mc-wl-card__actions button{background:transparent;border:1px solid rgba(var(--color-foreground),.18);color:rgb(var(--color-foreground));cursor:pointer}.mc-wishlist-empty{text-align:center;padding:70px 20px;border:1px dashed rgba(var(--color-foreground),.2);border-radius:16px}.mc-wishlist-empty__icon{font-size:5rem;line-height:1}.mc-wishlist-empty h2{margin:10px 0 6px}.mc-wishlist-empty p{color:rgba(var(--color-foreground),.65);margin:0 0 20px}@media(max-width:990px){.mc-wishlist-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.mc-wishlist-page{padding-top:25px}.mc-wishlist-page__head{align-items:start}.mc-wishlist-grid{gap:10px}.mc-wl-card__body{padding:10px}.mc-wl-card__title{font-size:1.3rem}.mc-wl-card__actions{flex-direction:column}.mc-wishlist-page__head h1{font-size:3rem}}
</style>

{% schema %}
{"name":"Wishlist","settings":[]}
{% endschema %}