<nav class="mc-mobile-nav" aria-label="Mobile shopping navigation">
  <a href="{{ routes.root_url }}"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>{% render 'mc-icon', name: 'home', size: 22 %}<span>Home</span></a>
  <a href="{{ routes.all_products_collection_url }}"{% if request.page_type == 'collection' or request.page_type == 'list-collections' %} aria-current="page"{% endif %}>{% render 'mc-icon', name: 'grid', size: 22 %}<span>Shop</span></a>
  <a href="/pages/wishlist"{% if request.path == '/pages/wishlist' %} aria-current="page"{% endif %}>{% render 'mc-icon', name: 'heart', size: 22 %}<span>Wishlist</span><span class="mc-count mc-wishlist-count"></span></a>
  <a href="{{ routes.account_url }}"{% if request.page_type == 'customers/account' %} aria-current="page"{% endif %}>{% render 'mc-icon', name: 'user', size: 22 %}<span>Account</span></a>
  <a href="{{ routes.cart_url }}"{% if request.page_type == 'cart' %} aria-current="page"{% endif %}>{% render 'mc-icon', name: 'bag', size: 22 %}<span>Cart</span>{% if cart.item_count > 0 %}<span class="mc-count">{{ cart.item_count }}</span>{% endif %}</a>
</nav>

{% schema %}
{
  "name": "ManaChoice mobile navigation",
  "settings": []
}
{% endschema %}
