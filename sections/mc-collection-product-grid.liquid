<section class="mc-collection">
  <div class="mc-container">
    <div class="mc-collection__head">
      <div>
        <p class="mc-kicker">Collection</p>
        <h1>{{ collection.title }}</h1>
        {%- if collection.description != blank -%}<div class="mc-collection__desc">{{ collection.description }}</div>{%- endif -%}
      </div>
      <div class="mc-collection__meta">
        <span>{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</span>
        {%- if collection.sort_options.size > 0 -%}
          {%- assign mc_sort = collection.sort_by | default: collection.default_sort_by -%}
          <div class="mc-sort">
            <label for="mc-sort-by">Sort by</label>
            <select id="mc-sort-by" data-mc-sort>
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}"{% if option.value == mc_sort %} selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- paginate collection.products by 24 -%}
      {%- if collection.products_count > 0 -%}
        <div class="mc-grid">
          {%- for product in collection.products -%}
            {% render 'mc-product-card', product: product, eager: forloop.first %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="mc-pagination" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
            <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="mc-empty">
          <h2>No products here yet</h2>
          <p>We're adding more products soon.</p>
          <a class="mc-btn" href="{{ routes.all_products_collection_url }}">Shop all products</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

<script>
  (function () {
    var select = document.querySelector('[data-mc-sort]');
    if (!select) return;
    select.addEventListener('change', function () {
      var url = new URL(window.location.href);
      url.searchParams.set('sort_by', select.value);
      url.searchParams.delete('page');
      window.location.href = url.toString();
    });
  })();
</script>

{% schema %}
{
  "name": "ManaChoice collection",
  "settings": []
}
{% endschema %}
